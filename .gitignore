# Газетир — 132 МБ, CI тягне його сам і кешує
gazetteer/
# Зібраний сайт — 20 МБ, повністю відтворюється з store/ за півтори хвилини.
# На Pages він потрапляє артефактом (upload-pages-artifact бере теку напряму),
# а не з репозиторію, тому в історії йому нема чого робити: інакше кожна з 48
# щоденних збірок додавала б у git новий набір HTML.
site/
# Недописані файли атомарного запису. У штатному режимі прибираються самі,
# але SIGKILL пропускає finally — щоб такі уламки не потрапили в коміт
# через `git add -A data store` у CI.
.*.tmp
# Проміжні файли збірки
raid_*.json
raid_*.html
night_*.json
night_*.html
__pycache__/
*.pyc
.DS_Store
.gstack/

# Кеш ранжування цілей у CI: жар рахується раз на добу, targets.json
# лишається байт-стабільним між прогонами й не перезаливається на хостинг.
.rank/

# Тайли підкладки редактора (супутник + нічні вогні) і завантажений Natural
# Earth: разом сотні мегабайт, відтворюються `mapper/mktiles.py` і
# `mapper/mkbase.py`. Дрібні basemap.js/labels.js/targets.js навпаки
# комітяться — без них редактор не відкриється.
mapper/tiles/
mapper/ne/
mapper/*.png
mapper/night.js
# проміжний файл збірки підкладки: редактор читає basemap.js, а не .json
mapper/basemap.json

# Локальний кеш і стан wrangler — створюється кожним запуском, у репо не потрібен.
.wrangler/
